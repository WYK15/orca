{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Orcaw Tauri",
  "version": "1.4.165-wyk.22-tauri.3",
  "identifier": "com.wyk15.orcaw.tauri",
  "build": {
    "beforeDevCommand": "node config/scripts/prepare-tauri-desktop.mjs --dev && node config/scripts/run-tauri-frontend.mjs --dev",
    "devUrl": "http://127.0.0.1:1420/tauri-index.html",
    "beforeBuildCommand": "node config/scripts/prepare-tauri-desktop.mjs && node config/scripts/run-tauri-frontend.mjs",
    "frontendDist": "../out/tauri-renderer"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Orcaw Tauri",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 16, "y": 11 },
        "url": "tauri-index.html",
        "width": 1400,
        "height": 900,
        "minWidth": 800,
        "minHeight": 500,
        "visible": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data: blob: https:; font-src 'self' data:; media-src 'self' blob: data:; connect-src 'self' ipc: http://ipc.localhost https: wss:; worker-src 'self' blob:; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "../resources/icon.png",
      "../resources/build/icon.icns",
      "../resources/build/icon.ico"
    ],
    "externalBin": ["binaries/orcaw-node"],
    "resources": {
      "../out/tauri-backend/": "backend/",
      "../out/tauri-resources/": "runtime/"
    },
    "macOS": { "minimumSystemVersion": "13.5" }
  }
}
